# ---- Server ----
PORT=5000
NODE_ENV=development
# Comma-separated origins allowed by CORS (Vite dev server, Electron, Capacitor)
CORS_ORIGINS=http://localhost:5173,capacitor://localhost,http://localhost,app://.

# ---- MySQL ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=bikripro
DB_PASSWORD=bikripro
DB_NAME=bikripro
# Offset used for NOW()/CURDATE() in MySQL (Bangladesh = +06:00)
DB_TIMEZONE=+06:00

# ---- Auth ----
# CHANGE THIS in production: any long random string
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=12h

# ---- Uploads ----
UPLOAD_DIR=uploads

# ---- SMS gateway (leave SMS_PROVIDER=log to only log messages) ----
# Supported: log | bulksmsbd | generic
SMS_PROVIDER=log
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER_ID=

# ---- Cron (Asia/Dhaka) ----
TZ=Asia/Dhaka
BIRTHDAY_SMS_CRON=0 10 * * *
