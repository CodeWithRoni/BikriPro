# ---- Server ----
PORT=5000
NODE_ENV=development
# Comma-separated origins allowed by CORS (* = any). Add your GitHub Pages URL.
CORS_ORIGINS=http://localhost:5173,https://codewithroni.github.io,capacitor://localhost,http://localhost

# ---- PostgreSQL / Supabase ----
# Supabase: Dashboard → your project → Connect → "Session pooler" → copy the URI
# and put your database password in it. Example:
# DATABASE_URL=postgresql://postgres.abcdefghijklmnop:YOUR-PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/bikripro
# 1 = use SSL (auto-enabled for supabase.com hosts)
DB_SSL=
DB_POOL_MAX=10
# Create tables & first admin automatically on start (0 = off)
AUTO_MIGRATE=1

# ---- Supabase Storage (product photos & logo) ----
# Leave empty to store images on this server's disk instead.
# SUPABASE_URL: Settings → API → Project URL
# SUPABASE_SECRET_KEY: Settings → API Keys → Secret key (sb_secret_...). NEVER put this in the frontend.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_BUCKET=bikripro

# ---- Auth ----
# CHANGE THIS in production: any long random string
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=12h

# ---- Uploads (used when Supabase Storage is not configured) ----
UPLOAD_DIR=uploads

# ---- SMS gateway (leave SMS_PROVIDER=log to only log messages) ----
# Supported: log | bulksmsbd | generic
SMS_PROVIDER=log
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER_ID=

# ---- Cron (Asia/Dhaka) ----
TZ=Asia/Dhaka
BIRTHDAY_SMS_CRON=0 10 * * *
