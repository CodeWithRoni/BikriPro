{
  "name": "bikripro-backend",
  "version": "1.0.0",
  "description": "BikriPro POS & ERP \u2014 REST API (Node.js, Express, PostgreSQL / Supabase)",
  "main": "src/server.js",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "migrate": "node src/db/migrate.js",
    "seed": "node src/db/seed.js",
    "setup": "npm run migrate && npm run seed",
    "test": "node --test tests/unit.test.js",
    "build:edge": "node scripts/build-edge.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^4.6.0",
    "pg": "^8.23.1",
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "esbuild": "^0.24.2"
  }
}
